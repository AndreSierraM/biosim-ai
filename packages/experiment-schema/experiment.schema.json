{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosim.ai/schemas/experiment-v1.json",
  "title": "ExperimentSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "engine",
    "seed",
    "entities",
    "parameters",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "intent": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2000
    },
    "engine": {
      "type": "string",
      "enum": [
        "physicell"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cell"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "positions",
          "cell_counts",
          "contact_events",
          "time_series"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
