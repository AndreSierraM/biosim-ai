# Copy to .env (never commit secrets). To go live with Meta:
# 1. https://dev.meta.ai -> Start building -> create an API key (format LLM|...).
# 2. export META_MODEL_API_KEY='LLM|...'  (or put it in .env, never commit it)
# 3. python3 scripts/probe-meta.py  (one tiny call, no solver, prints model/request id)
# Without a key, set BIOSIM_PLANNER_FIXTURE for the deterministic demo instead.
META_MODEL_API_KEY=
META_MODEL_NAME=muse-spark-1.3
META_MODEL_ENDPOINT=https://api.meta.ai/v1
BIOSIM_API_URL=http://localhost:8123
